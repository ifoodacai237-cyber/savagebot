generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/bot.db"
}

model Interaction {
  id      String @id @default(cuid())
  type    String
  fromId  String
  toId    String
  guildId String?
  count   Int    @default(1)

  @@unique([type, fromId, toId])
}

model TellonymProfile {
  id     String @id @default(cuid())
  userId String @unique
  link   String
}

model Ticket {
  id        String   @id @default(cuid())
  channelId String   @unique
  userId    String
  guildId   String
  reason    String
  answer1   String?
  answer2   String?
  answer3   String?
  claimedBy String?
  status    String   @default("open")
  createdAt DateTime @default(now())
}

model GuildConfig {
  id             String  @id @default(cuid())
  guildId        String  @unique

  ticketChannel   String?
  ticketCategory  String?
  ticketColor     String?
  ticketBanner    String?
  ticketThumb     String?
  ticketFooter    String?
  ticketTitle     String?
  ticketText      String?
  ticketPingRole  String?
  ticketBtnLabel      String?
  ticketBtnEmoji      String?
  ticketBtnStyle      String?
  ticketOpenText      String?
  ticketUseSeparator  Boolean @default(false)
  ticketQuestion1 String?
  ticketQuestion2 String?
  ticketQuestion3 String?

  instaChannel   String?
  instaColor     String  @default("833AB4")
  instaEmoji     String  @default("💜")

  tellonymChannel String?
  tellonymColor   String?
  tellonymBanner  String?
  tellonymThumb   String?
  tellonymFooter  String?
  tellonymTitle   String?
  tellonymText    String?

  lojaTitle      String?
  lojaText       String?
  lojaBanner     String?
  lojaThumb      String?
  lojaColor      String?
  lojaConversao  String?
  lojaUseDivider Boolean @default(false)

  welcomeEnabled   Boolean @default(true)
  welcomeChannel   String?
  welcomeColor     String?
  welcomeBanner    String?
  welcomeThumb     String?
  welcomeFooter    String?
  welcomeTitle     String?
  welcomeText      String?
  welcomeRoles     String?
  welcomeChannels  String?
}

model Economy {
  id          String    @id @default(cuid())
  userId      String
  guildId     String
  balance      Int       @default(0)
  bank         Int       @default(0)
  messageCount Int       @default(0)
  callMinutes  Int       @default(0)
  lastDaily    DateTime?
  lastWork    DateTime?
  dailyStreak Int       @default(0)
  lastPetPlay DateTime?
  lastPetFeed DateTime?
  lastPetPet  DateTime?

  @@unique([userId, guildId])
}

model PanelPreset {
  id        String   @id @default(cuid())
  guildId   String
  type      String
  name      String
  color     String?
  banner    String?
  thumb     String?
  footer    String?
  title     String?
  text      String?
  createdAt DateTime @default(now())

  @@unique([guildId, type, name])
}

model ShopRole {
  id          String   @id @default(cuid())
  guildId     String
  roleId      String
  name        String
  description String?
  price       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([guildId, roleId])
}

model UserPurchase {
  id          String   @id @default(cuid())
  userId      String
  guildId     String?
  itemType    String
  itemRef     String
  purchasedAt DateTime @default(now())

  @@unique([userId, itemType, itemRef])
}

model UserProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  guildId      String?
  activeBanner String?
  activeRing   String?
  activePet    String?
  bio          String?
}

model Pet {
  id          String   @id @default(cuid())
  guildId     String
  name        String
  emoji       String
  imageUrl    String?
  description String?
  price       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([guildId, name])
}

model Badge {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  emoji       String
  description String
  color       String @default("9B4FD6")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeKey])
}

model GuildBadgeEmoji {
  id       String @id @default(cuid())
  guildId  String
  badgeKey String
  emoji    String

  @@unique([guildId, badgeKey])
}

model CustomBanner {
  id          String   @id @default(cuid())
  guildId     String
  key         String
  name        String
  description String   @default("")
  price       Int      @default(1000)
  imageUrl    String
  gradient1   String   @default("#1a0533")
  gradient2   String   @default("#4a1a8a")
  emoji       String   @default("🖼️")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([guildId, key])
}
