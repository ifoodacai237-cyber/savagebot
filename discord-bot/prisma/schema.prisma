generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/bot.db"
}

model Interaction {
  id      String @id @default(cuid())
  type    String
  fromId  String
  toId    String
  guildId String
  count   Int    @default(1)

  @@unique([type, fromId, toId, guildId])
}

model TellonymProfile {
  id     String @id @default(cuid())
  userId String @unique
  link   String
}

model Ticket {
  id        String   @id @default(cuid())
  channelId String   @unique
  userId    String
  guildId   String
  reason    String
  claimedBy String?
  status    String   @default("open")
  createdAt DateTime @default(now())
}

model GuildConfig {
  id             String  @id @default(cuid())
  guildId        String  @unique

  ticketChannel  String?
  ticketCategory String?
  ticketColor    String?
  ticketBanner   String?
  ticketThumb    String?
  ticketFooter   String?
  ticketTitle    String?
  ticketText     String?

  instaChannel   String?
  instaColor     String  @default("833AB4")
  instaEmoji     String  @default("💜")

  tellonymChannel String?
  tellonymColor   String?
  tellonymBanner  String?
  tellonymThumb   String?
  tellonymFooter  String?
  tellonymTitle   String?
  tellonymText    String?
}

model Economy {
  id        String    @id @default(cuid())
  userId    String
  guildId   String
  balance   Int       @default(0)
  bank      Int       @default(0)
  lastDaily DateTime?
  lastWork  DateTime?

  @@unique([userId, guildId])
}

model PanelPreset {
  id        String   @id @default(cuid())
  guildId   String
  type      String
  name      String
  color     String?
  banner    String?
  thumb     String?
  footer    String?
  title     String?
  text      String?
  createdAt DateTime @default(now())

  @@unique([guildId, type, name])
}
